{
  "manifest_version": 3,
  "name": "Whisper Transcription Manager — videos to transcripts",
  "short_name": "Whisper TM",
  "version": "0.9.0",
  "key": "",
  "description": "Send YouTube videos from any page to your Whisper Transcription Manager to transcribe, summarize, analyze and ask about them.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/lexusmexus961/whisper-transcription-manager",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Whisper Transcription Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "videos.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "contextMenus",
    "notifications",
    "alarms",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
