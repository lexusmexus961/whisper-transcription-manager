# Whisper Transcription Manager — settings for docker-compose.yaml. Copy this file to .env
# next to it and edit .env (it holds your Hugging Face token: keep it
# private, it is never committed).

# Your media library on this machine; the container sees it read-only at
# /media. The default is a folder `media` next to docker-compose.yaml.
MEDIA_DIR=./media

# Hugging Face token for speaker diarization. Its account must have accepted
# the conditions of pyannote/speaker-diarization-community-1 (docs/GUIDE.md: Speaker
# diarization: the Hugging Face token). Empty = transcripts without speakers.
HF_TOKEN=

# Where the web interface is published: 127.0.0.1:9860 (this machine only)
# or a port (9860 → http://<this machine>:9860, from the whole network).
# There is no login unless you turn it on (docs/GUIDE.md: Network Access).
WHISPER_TM_PORT=127.0.0.1:9860

# The user the server runs as. Empty = the owner of ./config, which is right
# in almost every case; or the numbers `id -u` and `id -g` print.
PUID=
PGID=

# Time zone of the log timestamps, e.g. America/New_York
TZ=UTC

# No NVIDIA GPU? Remove the # in front of the next two lines: the server
# then transcribes on the CPU, much slower. (The separator line makes the ":"
# work on Windows too, where Compose otherwise expects ";".)
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yaml:docker-compose.cpu.yaml
